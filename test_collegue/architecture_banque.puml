@startuml
skinparam classAttributeIconSize 0
hide empty members
skinparam nodesep 220
skinparam ranksep 90

class "BanqueFacade" as BanqueFacade <<Facade>> #E2E2E2 {
  - secretInterne : String
  --
  + transfererFonds() : void
}

class "ServiceNotification" as ServiceNotification <<Service>> {
  + envoyer(String) : void
}

class "JournalAudit" as JournalAudit <<Service>> {
  + consigner(Operation) : void
}

interface "Auditable" as Auditable <<Contract>> {
  + {abstract} empreinteAudit() : String
}

interface "Identifiable" as Identifiable <<Contract>> {
  + {abstract} identifiant() : String
}

class "Adresse" as Adresse {
}

class "CarteBancaire" as CarteBancaire {
  + {static} DUREE_VALIDITE_ANNEES : int
  + numeroMasque : String
  --
  + bloquer() : void
  + {static} emettre(String) : CarteBancaire
}

class "ClientPremium" as ClientPremium <<Entity>> #ADD8E6 {
  + age : int
  - email : String
  - nom : String
  --
  + empreinteAudit() : String
  + fusionnerAvec(Client) : void
  + getNom() : String
  + getaway() : void
  + identifiant() : String
  + isMajeur() : boolean
  + setNom(String) : void
  + /soldeTotal() : double
  + toString() : String
}

class "Compte" as Compte <<AggregateRoot>> {
  ~ etiquettes : List&#60;String&#62;
  ~ numeroIban : String
  - plafondAutorise : double {plafondAutorise &#62; 0}
  --
  + cloturer() : void
  + deposer(double) : void
  + getSoldeSecret() : double
  + hashCode() : int
  + identifiant() : String
  + setSoldeSecret(double) : void
}

annotation "Confidentiel" as Confidentiel <<Marker>> {
}

class "Devise" as Devise {
  - code : String
  - symbole : String
  --
  + code() : String
  + convertir(double, Devise) : double
  + equals(Object) : boolean
  + hashCode() : int
  + symbole() : String
  + toString() : String
}

class "Operation" as Operation {
  # montant : double {montant != 0} {arrondi à deux décimales}
  + reference : String
  --
  # annuler() : void
  - calculerEmpreinte() : void
  + valider() : void
}

abstract class "Personne" as Personne <<Abstraction>> #LightYellow {
  # /ageEnAnnees : int
  # nomComplet : String
  --
  + getNomComplet() : String
  + {abstract} identifiant() : String
}

enum "TypeCompte" as TypeCompte {
  COURANT
  EPARGNE
  TITRES
  --
  + estRemunere() : boolean
  + {static} valueOf(String) : TypeCompte
  + {static} values() : TypeCompte[]
}

BanqueFacade --> "clients 0..*" ClientPremium : <i>expose</i>
BanqueFacade ..> ServiceNotification : <i>notifie via</i>
BanqueFacade ..> JournalAudit : <i>trace dans</i>
BanqueFacade ..> Devise
JournalAudit "journal 1" --> "consignées 0..* {ordered} {lecture seule}" Operation
JournalAudit ..> Compte : <i>audite</i>
Identifiable <|-- Auditable
ClientPremium o-right- "domicile 0..1" Adresse
ClientPremium --> "/cartesActives 0..*" CarteBancaire
ClientPremium "titulaire 1" *-down- "comptes 1..* {ordered} {un compte courant au moins}" Compte : <i>détient</i>
Personne <|-- ClientPremium
Auditable <|.. ClientPremium
Compte "*" -left-> "libellé en 1" Devise
Compte *-- "historique 0..* {ordered}" Operation : <i>enregistre</i>
Compte -up-> "1" TypeCompte : <i>de type</i>
Compte ..> Confidentiel : <i>marque ses champs</i>
Identifiable <|.. Compte
note top of BanqueFacade : Seul point d'entrée du domaine.
note right of Identifiable : Réalisée par ClientPremium et par Compte :\ndeux traits pointillés à triangle creux.
note right of Adresse : Coquille vide : strategy vaut NONE par défaut,\nmalgré trois attributs publics.
note right of CarteBancaire::numeroMasque
&#81;uatre derniers chiffres seulement :
&#108;e reste ne quitte jamais la base.
end note
note left of ClientPremium : Le « Premium » du nom vient de @UMLClass(name),\npas de la classe Java.
note right of ClientPremium : Seconde bulle sur la même classe : @UMLNote est répétable.
note left of ClientPremium::soldeTotal
&#82;ecalculé à chaque appel :
&#108;a barre oblique le dit.
end note
note right of ClientPremium : {email unique dans la banque}
note bottom of Compte : Racine d'agrégat : les opérations\nn'existent qu'au travers d'elle.
note right of Compte : {un compte clôturé n'accepte plus d'opération}
note right of Compte : {devise immuable après ouverture}
note right of Confidentiel : Boîte de nature « annotation » :\nun @interface, pas une interface.
note right of Devise : Un record est dessiné comme une classe :\nUML ne lui réserve aucune notation.
note right of Operation::calculerEmpreinte
&#83;HA-256 sur la référence et le montant.
end note
note right of Personne : Classe abstraite : PlantUML met son nom en italique.
@enduml
