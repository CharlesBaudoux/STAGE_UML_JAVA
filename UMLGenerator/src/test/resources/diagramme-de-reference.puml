@startuml
skinparam classAttributeIconSize 0
hide empty members
skinparam nodesep 220
skinparam ranksep 90

interface "Identifiable" as Identifiable {
}

abstract class "Personne" as Personne {
  # nom : String
  --
  + {abstract} valider() : void
}

enum "Statut" as Statut {
  ACTIF
  SUSPENDU
}

class "Commande" as Commande {
}

class "ServiceBancaire" as ServiceBancaire {
}

class "Client" as Client <<Entity>> #LightBlue {
  ~ /age : int
  - archivees : Commande [0..*]
  - compteur : int
  ~ etiquettes : String [0..*]
  ~ solde : double {solde positif}
  ~ statut : Statut
  --
  + crediter(montant : double) : void
  + historique() : String [0..*]
  + identifiant() : String
  + /resumer() : String
  + valider() : void
}

Identifiable <|.. Personne
Client "acheteur 1" *-down- "achats 0..* {ordered} {non vide}" Commande : <i>passe</i>
Client ..> ServiceBancaire : <i>facture via</i>
Personne <|-- Client
note top of Client : Coeur du domaine, ne pas exposer hors du module
note right of Client::solde
&#74;amais negatif
end note
note right of Client : {titulaire majeur}
@enduml
