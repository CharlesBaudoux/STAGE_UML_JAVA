<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.oliviercailloux</groupId>
        <artifactId>pom</artifactId>
        <version>0.0.30</version>
    </parent>

    
    <artifactId>umlg</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>UML Generator</name>

    <properties>
        <!--
            No source/target here: the parent pom sets maven.compiler.release=21, and "release"
            wins over "source" and "target" — writing them would give two inert lines and would
            suggest that they set the language level. The level is therefore changed in the
            parent, or through a local maven.compiler.release property.
        -->

        <!--
            The property, on top of the plugin configuration below: the default-testCompile
            execution redefines its configuration, and used to lose the option along the way —
            the test fixtures were then compiled without their parameter names. The property, for
            its part, holds for every execution of the compiler.
        -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!--
            PlantUML stays at 1.2024.4, and that is a forced choice, not an oversight.

            From 1.2025.0 on, the published jar embeds a copy of Guava (about two thousand
            com/google/common/ entries) while declaring a module-info. Both together make the
            dependency unusable for a modular consumer: javac refuses the compilation with
            "module io.github.oliviercailloux.umlg reads package com.google.common.base from both
            com.google.common and net.sourceforge.plantuml". A package can come from one module
            only, and there is nothing to be done on this side — short of giving up our own
            Guava, which is in the signature of the API.

            1.2026.6 moreover changes the signature of GraphvizUtils.addDotStatus, which
            PlantUmlWriter uses to detect a missing Graphviz.

            To be revisited if upstream stops embedding Guava, or publishes an unshaded artifact.
            The assertCompile calls of the suite — there are dozens of them — and its SVG
            renderings will say at once whether the syntax has moved.
        -->
        <dependency>
            <groupId>net.sourceforge.plantuml</groupId>
            <artifactId>plantuml</artifactId>
            <version>1.2024.4</version>
        </dependency>
        <!--
            Jackson, to read umlg.json.

            The library used to parse no format it had not invented itself: the rules file was
            written line by line, and its reader fitted in one dependency-free class. The format
            became JSON, and writing a JSON parser oneself would mean redoing, less well, work
            everybody has already done — with the escapes, the UTF-16 and the numbers that must
            be handled right.

            jackson-databind alone is declared; jackson-core and jackson-annotations come with
            it. Only the tree (JsonNode) is used, never binding to classes: refusals must name
            the faulty path in the file, which automatic binding cannot do.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.20.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                The version, without which Maven resolves the one from its super-POM: 3.1,
                published in 2013, older than the module system. The parent pom says nothing of
                this plugin — so that is not where to look. 3.1 puts every dependency on the
                classpath, where a "requires" cannot find them; 3.13 builds the module path as
                soon as a module-info.java is present.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!--
                        The library embeds its own annotation processor, declared in
                        META-INF/services. Without this line, javac would discover it while
                        compiling the library itself, with two consequences: it would try to run
                        before being compiled, and it would refuse the deliberately faulty test
                        fixtures — the very ones proving that run-time validation still works.

                        The processor is meant for the user's code, not for ours.
                    -->
                    <proc>none</proc>
                    <!--
                        Writes parameter names in the .class files (MethodParameters attribute).
                        Without this option, reflection knows only "arg0", "arg1"… and the
                        library then displays types only: "representations(String)" instead of
                        "representations(name: String)".

                        It is here for the test fixtures, which must be able to exercise both
                        cases. The user's project must set the same option on its side if it
                        wants to see its parameter names: it is their compiler that decides what
                        their .class files hold, not ours.
                    -->
                    <parameters>true</parameters>
                </configuration>
                <executions>
                    <!--
                        The tests live in the same packages as the code they check, and reach it
                        white-box. They therefore cross no module boundary, and have nothing to
                        gain from being compiled inside it: there they merely inherit its
                        constraints, at the price of two annoyances. First javax.tools, which two
                        integration tests need, would require a "requires java.compiler" that the
                        library has no reason to declare. Second javac and the Eclipse compiler
                        do not agree on what a "patched" module may read, which leaves the IDE red
                        on a project Maven compiles.

                        The tests are therefore compiled on the classpath, like ordinary code.
                        What the module guarantees its users does not depend on it: the published
                        jar is governed by module-info.java, and by it alone.
                    -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <useModulePath>false</useModulePath>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>io.github.oliviercailloux.umlg.UMLGenerator</mainClass>
                </configuration>
            </plugin>

            <!--
                No version: the parent pom manages one in pluginManagement, and writing it here
                would cancel it — that is how the project once found itself over a year behind
                the Surefire fixes. The configuration alone, with no version, adds to the
                parent's rather than replacing it.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The tests are compiled on the classpath: they are run there too. -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>

            <!--
                The Javadoc of the public API, generated by the build.

                What this block repairs. The parent pom does configure the plugin, but in
                pluginManagement only: nothing ran it, and the documentation existed nowhere.
                Worse, calling it by hand failed with an opaque message — "Creating an aggregated
                report for both named and unnamed modules is not possible" — which blamed the
                project itself.

                The cause. The "javadoc" goal triggers the generate-sources phase only: it does
                not compile. Without target/classes/module-info.class, the plugin does not see
                that this library is a named module, files it among the unnamed ones, and refuses
                to mix the two. Hence the execution below, bound to "package": the phase implies
                compile, the module descriptor is there, and the question no longer arises. "mvn
                verify" therefore produces the documentation, and CI checks at the same time that
                it is still generated.

                On the command line, write "mvn compile javadoc:javadoc" and not "mvn
                javadoc:javadoc": the same reason, and the same message if it is forgotten.

                Only the three packages exported by module-info.java appear — the facade, the
                annotations, the model. The rest is closed, hence off topic for whoever reads
                this documentation: its comments address the maintainer, and are written with
                "//" for that reason.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>apidocs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>javadoc</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!--
                        The language of the documentation, and UTF-8 end to end: without these
                        lines, non-ASCII characters of the comments come out as mojibake in the
                        produced HTML.
                    -->
                    <locale>en_US</locale>
                    <encoding>UTF-8</encoding>
                    <docencoding>UTF-8</docencoding>
                    <charset>UTF-8</charset>
                    <!--
                        The timestamp removed: without it, two generations of the same code give
                        identical files, and a diff shows only what really changed.
                    -->
                    <notimestamp>true</notimestamp>
                    <!--
                        doclint stays whole — "missing" included. A public member without a
                        comment is reported, which is the only way of seeing the next public
                        class one would forget to document coming. It warns without breaking the
                        build: failOnWarnings would remain to be discussed the day the count is
                        durably at zero.
                    -->
                    <doclint>all</doclint>
                </configuration>
            </plugin>

            <!--
                Coverage, measured by the build rather than by hand.

                It already exceeded ninety-five percent of the instructions, and nothing
                protected it: no tool computed it, no threshold defended it. High coverage that
                is not measured is coverage that drops with nobody seeing it. Today's figure is
                read in the report the build generates (target/site/jacoco/), and therefore has
                no business here.

                The threshold is set below the value reached, and not at it: it is there to
                report a drop, not to forbid writing a line hard to cover on a refactoring day.
                "mvn verify" applies it; "mvn test" only measures.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>threshold</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.92</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>