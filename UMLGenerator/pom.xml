<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.oliviercailloux</groupId>
        <artifactId>pom</artifactId>
        <version>0.0.30</version>
    </parent>

    
    <artifactId>umlg</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>UML Generator</name>

    <properties>
        <!--
            Aucun source/target ici : le pom parent pose maven.compiler.release=21, et « release »
            l'emporte sur « source » et « target » — les écrire donnerait deux lignes inertes et
            laisserait croire que ce sont elles qui fixent le palier de langage. Le palier se
            change donc chez le parent, ou par une propriété maven.compiler.release locale.
        -->

        <!--
            La propriété, en plus de la configuration du plugin ci-dessous : l'exécution
            default-testCompile redéfinit sa configuration, et perdait l'option au passage —
            les cobayes des tests étaient alors compilés sans leurs noms de paramètres. La
            propriété, elle, vaut pour toutes les exécutions du compilateur.
        -->
        <maven.compiler.parameters>true</maven.compiler.parameters>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>

        <!--
            PlantUML reste en 1.2024.4, et c'est un choix contraint, non un oubli.

            À partir de 1.2025.0, le jar publié embarque une copie de Guava (environ deux mille
            entrées com/google/common/) tout en déclarant un module-info. Les deux ensemble
            rendent la dépendance inutilisable pour un consommateur modulaire : javac refuse la
            compilation sur « module io.github.oliviercailloux.umlg reads package
            com.google.common.base from both com.google.common and net.sourceforge.plantuml ».
            Un paquetage ne peut venir que d'un module, et il n'y a rien à faire de ce côté-ci —
            sinon renoncer à notre propre Guava, qui est dans la signature de l'API.

            La 1.2026.6 change de surcroît la signature de GraphvizUtils.addDotStatus, dont
            PlantUmlWriter se sert pour détecter un Graphviz absent.

            À reprendre si l'amont cesse d'embarquer Guava, ou publie un artefact non ombré. Les
            appels d'assertCompile de la suite — il y en a des dizaines — et ses rendus SVG
            diront aussitôt si la syntaxe a bougé.
        -->
        <dependency>
            <groupId>net.sourceforge.plantuml</groupId>
            <artifactId>plantuml</artifactId>
            <version>1.2024.4</version>
        </dependency>
        <!--
            Jackson, pour lire umlg.json.

            La bibliothèque n'analysait auparavant aucun format qu'elle n'eût inventé : le
            fichier de règles s'écrivait ligne à ligne, et son lecteur tenait en une classe sans
            dépendance. Le format est devenu JSON, et écrire soi-même un analyseur JSON serait
            recommencer, en moins bien, un travail que tout le monde a déjà fait — avec les
            échappements, l'UTF-16 et les nombres qu'il faut traiter juste.

            jackson-databind seul est déclaré ; jackson-core et jackson-annotations viennent avec
            lui. Seul l'arbre (JsonNode) est employé, jamais la liaison à des classes : les
            refus doivent nommer le chemin fautif dans le fichier, ce qu'une liaison
            automatique ne sait pas faire.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.20.1</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                La version, faute de quoi Maven résout celle de son super-POM : la 3.1, publiée
                en 2013, antérieure au système de modules. Le pom parent, lui, ne dit rien de ce
                plugin — ce n'est donc pas chez lui qu'il faudrait aller chercher. La 3.1 place
                toutes les dépendances sur le classpath, où un « requires » ne peut pas les
                trouver ; la 3.13 construit le module path dès qu'un module-info.java est présent.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!--
                        La bibliothèque embarque son propre processeur d'annotations, déclaré
                        dans META-INF/services. Sans cette ligne, javac le découvrirait en
                        compilant la bibliothèque elle-même, avec deux conséquences : il
                        tenterait de s'exécuter avant d'être compilé, et il refuserait les
                        cobayes délibérément fautifs des tests — ceux-là mêmes qui prouvent que
                        la validation d'exécution fonctionne toujours.

                        Le processeur est destiné au code de l'utilisateur, pas au nôtre.
                    -->
                    <proc>none</proc>
                    <!--
                        Écrit les noms des paramètres dans les .class (attribut MethodParameters).
                        Sans cette option, la réflexion ne connaît que « arg0 », « arg1 »… et la
                        bibliothèque n'affiche alors que les types : « representations(String) »
                        au lieu de « representations(name: String) ».

                        Elle est ici pour les cobayes des tests, qui doivent pouvoir exercer les
                        deux cas. Le projet de l'utilisateur, lui, doit poser la même option chez
                        lui s'il veut voir les noms de ses paramètres : c'est son compilateur qui
                        décide de ce que ses .class contiennent, pas le nôtre.
                    -->
                    <parameters>true</parameters>
                </configuration>
                <executions>
                    <!--
                        Les tests vivent dans les mêmes paquetages que le code qu'ils vérifient,
                        et l'atteignent en boîte blanche. Ils ne franchissent donc aucune
                        frontière de module, et n'ont rien à gagner à être compilés à
                        l'intérieur de celui-ci : ils y héritent seulement de ses contraintes,
                        au prix de deux ennuis. D'abord javax.tools, dont deux tests
                        d'intégration ont besoin, exigerait un « requires java.compiler » que la
                        bibliothèque, elle, n'a aucune raison de déclarer. Ensuite javac et le
                        compilateur d'Eclipse ne s'accordent pas sur ce qu'un module « patché »
                        peut lire, ce qui laisse l'IDE rouge sur un projet que Maven compile.

                        Les tests sont donc compilés sur le classpath, comme du code ordinaire.
                        Ce que le module garantit à ses utilisateurs n'en dépend pas : c'est le
                        module-info.java qui gouverne le jar publié, et lui seul.
                    -->
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <useModulePath>false</useModulePath>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>io.github.oliviercailloux.umlg.UMLGenerator</mainClass>
                </configuration>
            </plugin>

            <!--
                Pas de version : le pom parent en gère une en pluginManagement, et l'écrire ici
                l'annulerait — c'est ainsi que le projet s'était retrouvé plus d'un an en arrière
                des correctifs de Surefire. La configuration seule, sans version, s'ajoute à celle
                du parent au lieu de la remplacer.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Les tests sont compilés sur le classpath : ils y sont aussi exécutés. -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>

            <!--
                La Javadoc de l'API publique, engendrée par la construction.

                Ce que ce bloc répare. Le pom parent configure bien le plugin, mais en
                pluginManagement seul : rien ne l'exécutait, et la documentation n'existait
                nulle part. Pire, l'appeler à la main échouait sur un message opaque —
                « Creating an aggregated report for both named and unnamed modules is not
                possible » — qui accusait le projet lui-même.

                La cause. Le goal « javadoc » ne déclenche que la phase generate-sources : il ne
                compile pas. Sans target/classes/module-info.class, le plugin ne voit pas que
                cette bibliothèque est un module nommé, la range parmi les modules anonymes, et
                refuse de mélanger les deux. D'où l'exécution ci-dessous, liée à « package » :
                la phase implique compile, le descripteur de module est là, et la question ne se
                pose plus. « mvn verify » produit donc la documentation, et la CI vérifie du même
                coup qu'elle s'engendre toujours.

                En ligne de commande, écrire « mvn compile javadoc:javadoc » et non
                « mvn javadoc:javadoc » : la même raison, et le même message si on l'oublie.

                Seuls les trois paquetages exportés par module-info.java paraissent — la façade,
                les annotations, le modèle. Le reste est fermé, donc hors sujet pour qui lit
                cette documentation : ses commentaires s'adressent au mainteneur, et sont écrits
                en « // » pour cela.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>apidocs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>javadoc</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!--
                        Le français de la documentation, et l'UTF-8 de bout en bout : sans ces
                        trois lignes, les accents des commentaires ressortent en mojibake dans le
                        HTML produit.
                    -->
                    <locale>fr_FR</locale>
                    <encoding>UTF-8</encoding>
                    <docencoding>UTF-8</docencoding>
                    <charset>UTF-8</charset>
                    <!--
                        L'horodatage retiré : sans lui, deux générations du même code donnent des
                        fichiers identiques, et un diff ne montre que ce qui a vraiment changé.
                    -->
                    <notimestamp>true</notimestamp>
                    <!--
                        doclint reste entier — « missing » compris. Un membre public sans
                        commentaire est signalé, ce qui est le seul moyen de voir venir la
                        prochaine classe publique qu'on oublierait de documenter. Il avertit sans
                        rompre la construction : failOnWarnings resterait à discuter le jour où
                        le compte sera durablement à zéro.
                    -->
                    <doclint>all</doclint>
                </configuration>
            </plugin>

            <!--
                La couverture, mesurée par la construction plutôt qu'à la main.

                Elle dépassait déjà les quatre-vingt-quinze pour cent des instructions, et rien ne
                la protégeait : aucun outil ne la calculait, aucun seuil ne la défendait. Une
                couverture haute qu'on ne mesure pas est une couverture qui baisse sans que
                personne le voie. Le chiffre du jour se lit dans le rapport que la construction
                engendre (target/site/jacoco/), et n'a donc rien à faire ici.

                Le seuil est posé sous la valeur atteinte, et non à la valeur atteinte : il est
                là pour signaler un décrochage, pas pour interdire d'écrire une ligne difficile à
                couvrir un jour de refactorisation. « mvn verify » l'applique ; « mvn test » ne
                fait que mesurer.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>seuil</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.92</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>