<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.oliviercailloux</groupId>
    <artifactId>pom</artifactId>
    <version>0.0.30</version>
  </parent>
  <artifactId>keyboardd</artifactId>
  <version>0.0.3-SNAPSHOT</version>

  <properties>
    <!--
      Aucun source/target ici : le pom parent pose maven.compiler.release=21, et « release »
      l'emporte sur « source » et « target ». Les écrire donnerait deux lignes inertes, et
      laisserait croire que ce sont elles qui fixent le palier de langage. Les « sealed
      interface » et les « record » du code exigent de toute façon 17 au minimum, et 21 est le
      palier d'umlg : le compte est bon sans rien écrire.
    -->

    <!--
      Écrit les noms des paramètres dans les .class. Sans cette option, la réflexion ne
      connaît que « arg0 », « arg1 »… et umlg n'affiche alors que les types :
      « entries(String) » au lieu de « entries(xKeyName: String) », comme sur les
      diagrammes du README.
    -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!--
      La bibliothèque d'annotations UML. Elle embarque un processeur d'annotations, nommé
      explicitement dans annotationProcessorPaths plus bas plutôt que laissé découvrir par
      META-INF/services : javac avertit désormais que la découverte par le classpath
      disparaîtra. La dépendance reste nécessaire pour compiler les annotations elles-mêmes.
    -->
    <dependency>
      <groupId>io.github.oliviercailloux</groupId>
      <artifactId>umlg</artifactId>
      <version>1.0-SNAPSHOT</version>
    </dependency>

    <dependency>
      <groupId>io.github.oliviercailloux</groupId>
      <artifactId>jaris</artifactId>
      <version>0.0.42</version>
    </dependency>
    <dependency>
      <groupId>io.github.oliviercailloux</groupId>
      <artifactId>svgb</artifactId>
      <version>0.0.8</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.20.1</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <version>2.20</version>
    </dependency>

    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>1.5.18</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Engendre les diagrammes : « mvn compile umlg:generate ».
        Plus d'arguments positionnels ni de mainClass : les défauts du plugin disent l'usage —
        target/classes analysé (avec le fichier umlg.json que la construction y recopie),
        diagrammes/ écrit à la racine du projet. Un seul fichier plutôt qu'un dossier :
        « mvn compile umlg:generate -Dumlg.outputFile=Keyboardd.svg ».
      -->
      <plugin>
        <groupId>io.github.oliviercailloux</groupId>
        <artifactId>umlg-maven-plugin</artifactId>
        <version>1.0-SNAPSHOT</version>
        <executions>
          <execution>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Le bloc que le README d'umlg prescrit, écrit ici en entier : ce projet est la preuve de
        bout en bout, et la moitié « compilation » de cette preuve ne vaut que si le processeur
        y travaille dans les mêmes conditions que chez un utilisateur.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <!--
          La version, faute de quoi Maven résout celle de son super-POM : la 3.1, publiée en
          2013, antérieure au paramètre « parameters » — maven.compiler.parameters ci-dessus
          serait alors ignoré en silence.
        -->
        <version>3.13.0</version>
        <configuration>
          <!--
            Sans showWarnings, Maven passe « -nowarn » à javac, ce qui fait taire tous les
            avertissements du processeur d'annotations d'umlg — c'est-à-dire tout ce qu'il a à
            dire, ses erreurs mises à part. Une compilation silencieuse cesserait alors de rien
            prouver.
          -->
          <showWarnings>true</showWarnings>
          <!--
            Nomme le processeur au lieu de le laisser découvrir par META-INF/services, la forme
            dont javac annonce la disparition.
          -->
          <annotationProcessorPaths>
            <path>
              <groupId>io.github.oliviercailloux</groupId>
              <artifactId>umlg</artifactId>
              <version>1.0-SNAPSHOT</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <!--
              Donne au processeur le fichier de règles du projet — celui-là même que la
              construction recopie dans target/classes pour la génération. Sans cette option il
              ignore « strategy none », et se tait donc sur tout ce qui en dépend, dans le
              projet où ces contrôles sont justement les plus utiles.

              Le chemin est absolu par ${project.basedir} : javac résout un chemin relatif
              contre son répertoire de travail, qui n'est pas nécessairement celui du projet.
            -->
            <arg>-Aumlg.rules=${project.basedir}/src/main/resources/umlg.rules</arg>
          </compilerArgs>
        </configuration>
      </plugin>

    </plugins>
  </build>
</project>
