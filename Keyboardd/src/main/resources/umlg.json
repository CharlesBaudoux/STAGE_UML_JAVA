{
  "$schema": "https://raw.githubusercontent.com/CharlesBaudoux/STAGE_UML_JAVA/main/UMLGenerator/src/main/resources/umlg-schema.json",
  "_strategy": "No box shows its members by default: each class asks for it.",
  "strategy": "none",

  "_types": "Guava's types teach the diagram reader nothing.",
  "types": {
    "ImmutableSet": "Set",
    "ImmutableList": "List",
    "ImmutableMap": "Map",
    "ImmutableBiMap": "BiMap"
  },

  "_notation": "The notation of hand-kept diagrams: no void, no visibilities, no {abstract}.",
  "omit": ["return void", "visibility", "abstract"],
  "multiplicity": "brackets",
  "order": "declaration",

  "views": [
    { "name": "XKeys", "retain": ["Xkeys"] },
    {
      "name": "Mapping",
      "retain": ["KeysymEntry", "Mnemonic", "Ucp", "Code", "KeyboardMap", "XkbSymbolsReader"],
      "direction": "left-to-right"
    },
    {
      "name": "Mnemonics",
      "retain": ["CanonicalKeysymEntry", "CanonicalMnemonic", "ImplicitUcp", "Mnemonics",
        "CanonicalKeyboardMap"]
    },
    {
      "name": "Representable",
      "retain": ["Representation", "StringRepresentation", "SvgRepresentation",
        "XKeyNamesRepresenter", "XKeyNamesAndRepresenter", "CanonicalKeyboardMapRepresenter",
        "RectangularKey", "RectangularKeyboard", "SvgKeyboard"],
      "direction": "left-to-right"
    },
    { "name": "Around SvgKeyboard", "retain": [{ "around": "SvgKeyboard" }] },
    { "name": "Around CanonicalKeyboardMap", "retain": [{ "around": "CanonicalKeyboardMap" }] }
  ],

  "viewsByPackage": true
}
